<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Aoc.Library</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Calendar.fs" />
    <Compile Include="Solution.fs" />
    <!-- Each day's files (Input.fs, Primary.fs, explorations) go under Y<YEAR>/Day<DD>/ before that year's Registry.fs; a new year's Registry.fs goes before the root Registry.fs. -->
    <Compile Include="Y2017/Day01/Input.fs" />
    <Compile Include="Y2017/Day01/Primary.fs" />
    <Compile Include="Y2017/Day02/Input.fs" />
    <Compile Include="Y2017/Day02/Primary.fs" />
    <Compile Include="Y2017/Day03/Input.fs" />
    <Compile Include="Y2017/Day03/Primary.fs" />
    <Compile Include="Y2017/Day04/Input.fs" />
    <Compile Include="Y2017/Day04/Primary.fs" />
    <Compile Include="Y2017/Day05/Input.fs" />
    <Compile Include="Y2017/Day05/Primary.fs" />
    <Compile Include="Y2017/Day06/Input.fs" />
    <Compile Include="Y2017/Day06/Primary.fs" />
    <Compile Include="Y2017/Day07/Input.fs" />
    <Compile Include="Y2017/Day07/Primary.fs" />
    <Compile Include="Y2017/Registry.fs" />
    <Compile Include="Registry.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
