<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableExpectoTestingPlatformIntegration>true</EnableExpectoTestingPlatformIntegration>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Repository.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="CalendarTests.fs" />
    <Compile Include="SolutionTests.fs" />
    <Compile Include="OpsTests.fs" />
    <Compile Include="Y2017/Day01Tests.fs" />
    <Compile Include="Y2017/Day02Tests.fs" />
    <Compile Include="Y2017/Day03Tests.fs" />
    <Compile Include="Y2017/Day04Tests.fs" />
    <Compile Include="Y2017/Day05Tests.fs" />
    <Compile Include="Y2017/Day06Tests.fs" />
    <Compile Include="Y2017/Day07Tests.fs" />
    <Compile Include="Y2017/Day08Tests.fs" />
    <Compile Include="Y2017/Day09Tests.fs" />
    <Compile Include="Y2017/Day10Tests.fs" />
    <Compile Include="Y2017/Day11Tests.fs" />
    <Compile Include="Y2017/Day12Tests.fs" />
    <Compile Include="Y2017/Day13Tests.fs" />
    <Compile Include="Y2017/Day14Tests.fs" />
    <!-- Day tests go in Y<YEAR>/Day<DD>Tests.fs. -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <ProjectReference Include="../../src/Aoc/Aoc.fsproj" />
    <ProjectReference Include="../../app/Aoc.Ops/Aoc.Ops.fsproj" />
  </ItemGroup>
</Project>
